{
  "extends": "@gilbarbara/tsconfig",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "~/*": ["./src/*"],
      "~/test-utils": ["./tests/__setup__/test-utils.tsx"],
      "~/test-mocks": ["./tests/__setup__/mocks.ts"],
      "~/test-fixtures": ["./tests/__setup__/fixtures.ts"]
    },
    "plugins": [{ "name": "next" }],
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "app", "next-env.d.ts", "next.config.mjs", "vitest.config.ts"]
}
