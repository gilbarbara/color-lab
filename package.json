{
  "name": "color-lab",
  "version": "1.0.5",
  "description": "A design tool for creating and fine-tuning perceptual color scales.",
  "type": "module",
  "dependencies": {
    "@gilbarbara/helpers": "^0.9.5",
    "@gilbarbara/hooks": "^0.11.0",
    "@heroui/react": "^2.8.10",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.53.1",
    "@transience/color-picker": "^0.4.0",
    "@unhead/react": "^3.1.0",
    "colorizr": "^5.0.1",
    "firebase": "^12.13.0",
    "framer-motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@gilbarbara/eslint-config": "^1.2.1",
    "@gilbarbara/prettier-config": "^1.0.0",
    "@gilbarbara/tsconfig": "^1.0.0",
    "@playwright/test": "^1.60.0",
    "@react-types/shared": "^3.34.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-playwright": "^2.10.4",
    "husky": "^9.1.7",
    "jest-extended": "^7.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "repo-tools": "^0.3.1",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "dev": "portless run vite",
    "dev:e2e": "vite --mode e2e",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --cache --fix src tests e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --log-level=warn src/",
    "validate": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "prettier": "@gilbarbara/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "vitest related --run"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.1.1"
}
