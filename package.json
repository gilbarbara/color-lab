{
  "name": "color-lab",
  "version": "3.2.0",
  "description": "A design tool for creating and fine-tuning perceptual color scales.",
  "homepage": "https://lab.colormeup.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilbarbara/color-lab.git"
  },
  "bugs": "https://github.com/gilbarbara/color-lab/issues",
  "type": "module",
  "dependencies": {
    "@gilbarbara/helpers": "^0.9.5",
    "@gilbarbara/hooks": "^0.11.0",
    "@heroui/react": "^2.8.10",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@transience/color-picker": "^0.5.0",
    "@wrksz/themes": "^2.0.2",
    "colorizr": "^5.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.4",
    "next": "^16.3.6",
    "postcss": "^8.5.28",
    "posthog-js": "^1.434.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gilbarbara/eslint-config": "^1.2.3",
    "@gilbarbara/prettier-config": "^1.0.0",
    "@gilbarbara/tsconfig": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "@react-types/shared": "3.36.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.0",
    "husky": "^9.1.7",
    "jest-extended": "^7.0.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "repo-tools": "^0.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "node scripts/standalone.mjs",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint --cache --fix src app tests e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p e2e/tsconfig.json",
    "format": "prettier --write --log-level=warn src/ app/",
    "validate": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report"
  },
  "prettier": "@gilbarbara/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "vitest related --run"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
