{
  "name": "color-lab",
  "version": "2.0.0",
  "description": "A design tool for creating and fine-tuning perceptual color scales.",
  "homepage": "https://lab.colormeup.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilbarbara/color-lab.git"
  },
  "bugs": "https://github.com/gilbarbara/color-lab/issues",
  "type": "module",
  "dependencies": {
    "@gilbarbara/helpers": "^0.9.5",
    "@gilbarbara/hooks": "^0.11.0",
    "@heroui/react": "^2.8.10",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.56.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@transience/color-picker": "^0.4.0",
    "colorizr": "^5.0.1",
    "firebase": "^12.14.0",
    "framer-motion": "^12.40.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gilbarbara/eslint-config": "^1.2.1",
    "@gilbarbara/prettier-config": "^1.0.0",
    "@gilbarbara/tsconfig": "^1.0.0",
    "@playwright/test": "^1.60.0",
    "@react-types/shared": "3.35.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-playwright": "^2.10.4",
    "husky": "^9.1.7",
    "jest-extended": "^7.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "repo-tools": "^0.3.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "node scripts/standalone.mjs",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint --cache --fix src app tests e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p e2e/tsconfig.json",
    "format": "prettier --write --log-level=warn src/ app/",
    "validate": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report"
  },
  "prettier": "@gilbarbara/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "vitest related --run"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
