{
  "name": "color-lab",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@gilbarbara/helpers": "^0.9.5",
    "@gilbarbara/hooks": "^0.10.4",
    "@heroui/react": "^2.8.7",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.33.0",
    "appwrite": "^21.5.0",
    "colorizr": "^4.0.1",
    "framer-motion": "^12.26.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@gilbarbara/eslint-config": "^1.0.3",
    "@gilbarbara/prettier-config": "^1.0.0",
    "@gilbarbara/tsconfig": "^1.0.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest-extended": "^7.0.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "repo-tools": "^0.3.1",
    "serve": "^14.2.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --cache --fix src tests e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --log-level=warn src/",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "prettier": "@gilbarbara/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "vitest related --run"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
