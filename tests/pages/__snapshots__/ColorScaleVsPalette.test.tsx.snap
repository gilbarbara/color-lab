          />
        </div>
      </div>
      <div>
        <p
          class="font-semibold mb-2"
        >
          Palette: distinct hues, side by side
        </p>
        <div
          class="grid grid-cols-6 gap-1 sm:max-w-[55%]"
        >
          <div
