// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pages/Privacy > renders correctly 1`] = `
<div
  class="flex flex-col flex-1"
  data-testid="Privacy"
>
  <div
    class="w-full max-w-7xl mx-auto flex-1 pt-8 md:pt-16 px-4 md:px-8 pb-16"
  >
    <h1
      class="text-4xl font-bold mb-2"
    >
      Privacy Policy
    </h1>
    <p
      class="text-foreground-500 mb-8"
    >
      Effective: January 2026
    </p>
    <p
      class="mb-8"
    >
      ColorMeUp LAB ("we", "us") is a color palette design tool available at
       
      <strong>
        lab.colormeup.co
      </strong>
      . This policy describes what data we collect, how we use it, and your rights regarding that data.
    </p>
    <h2
      class="text-2xl font-bold mb-4"
    >
      Information We Collect
    </h2>
    <div
      class="space-y-2 mb-8"
    >
      <h3
        class="text-lg font-semibold"
      >
        Account Data
      </h3>
      <p>
        When you create an account, we collect your 
        <strong>
          email address
        </strong>
         and
         
        <strong>
          name
        </strong>
         (optional). If you sign in with Google or GitHub, we also receive your 
        <strong>
          profile avatar URL
        </strong>
         from the provider.
      </p>
      <p>
        Passwords are hashed server-side by Firebase Authentication and are never stored in plain text. We do not have access to your plain-text password.
      </p>
      <h3
        class="text-lg font-semibold mt-4"
      >
        Palette Data
      </h3>
      <p>
        When you save a palette, we store a 
        <strong>
          palette name
        </strong>
        , the
         
        <strong>
          encoded palette URL
        </strong>
         (containing your color and scale settings), and whether you marked it as a favorite. Each saved palette is associated with your user ID.
      </p>
      <h3
        class="text-lg font-semibold mt-4"
      >
        Usage Analytics
      </h3>
      <p>
        We use 
        <strong>
          Umami
        </strong>
        , a privacy-focused analytics tool, to track page views and basic events (e.g., login method used, palette saves). Umami does not use cookies and does not collect personally identifiable information.
      </p>
      <h3
        class="text-lg font-semibold mt-4"
      >
        Error Logs
      </h3>
      <p>
        We use 
        <strong>
          Sentry
        </strong>
         for error tracking. When an error occurs, Sentry captures technical details about the error (stack trace, browser info). This data is used solely to diagnose and fix bugs.
      </p>
      <h3
        class="text-lg font-semibold mt-4"
      >
        Local Storage
      </h3>
      <p>
        We store your 
        <strong>
          dark mode preference
        </strong>
         in your browser's local storage. This data stays on your device and is not sent to our servers.
      </p>
    </div>
    <h2
      class="text-2xl font-bold mb-4"
    >
      How We Use Your Information
    </h2>
    <div
      class="space-y-2 mb-8"
    >
      <ul
        class="list-disc pl-6 space-y-1"
      >
        <li>
          Authenticate your account and manage sessions
        </li>
        <li>
          Save and retrieve your palettes
        </li>
        <li>
          Display your profile avatar
        </li>
        <li>
          Understand how the app is used (aggregated analytics)
        </li>
        <li>
          Identify and fix errors
        </li>
      </ul>
      <p
        class="mt-2"
      >
        We do not sell your data. We do not use your data for advertising or profiling.
      </p>
    </div>
    <h2
      class="text-2xl font-bold mb-4"
    >
      Third-Party Services
    </h2>
    <div
      class="space-y-2 mb-8"
    >
      <ul
        class="list-disc pl-6 space-y-1"
      >
        <li>
          <strong>
            Firebase (Google Cloud)
          </strong>
           — Authentication and database hosting (US region).
           
          <a
            class="underline"
            href="https://firebase.google.com/support/privacy"
            rel="noopener noreferrer"
            target="_blank"
          >
            Privacy Policy
          </a>
        </li>
        <li>
          <strong>
            Google OAuth
          </strong>
           — Sign-in provider. Shares your email, name, and avatar with us during authentication.
           
          <a
            class="underline"
            href="https://policies.google.com/privacy"
            rel="noopener noreferrer"
            target="_blank"
          >
            Privacy Policy
          </a>
        </li>
        <li>
          <strong>
            GitHub OAuth
          </strong>
           — Sign-in provider. Shares your email, name, and avatar with us during authentication.
           
          <a
            class="underline"
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            rel="noopener noreferrer"
            target="_blank"
          >
            Privacy Policy
          </a>
        </li>
        <li>
          <strong>
            Umami
          </strong>
           — Privacy-focused analytics. No cookies, no personal data collection.
        </li>
        <li>
          <strong>
            Sentry
          </strong>
           — Error tracking. Captures technical error data only.
        </li>
      </ul>
    </div>
    <h2
      class="text-2xl font-bold mb-4"
    >
      Data Storage and Security
    </h2>
    <div
      class="space-y-2 mb-8"
    >
      <p>
        Your account and palette data is stored on Firebase (Google Cloud) servers. All communication between your browser and our services uses HTTPS encryption.
      </p>
      <p>
        Access to your saved palettes is restricted to your account through Firestore security rules.
      </p>
    </div>
    <h2
      class="text-2xl font-bold mb-4"
    >
      Your Rights
    </h2>
    <div
      class="space-y-2 mb-8"
    >
      <p>
        You can:
      </p>
      <ul
        class="list-disc pl-6 space-y-1"
      >
        <li>
          Access and view your saved data through the app
        </li>
        <li>
          Delete individual palettes at any time
        </li>
        <li>
          Request deletion of your account and all associated data by contacting us
        </li>
      </ul>
    </div>
    <h2
      class="text-2xl font-bold mb-4"
    >
      Children's Privacy
    </h2>
    <p
      class="mb-8"
    >
      This service is not directed at children under 13. We do not knowingly collect data from children under 13. If you believe a child has provided us with personal data, please contact us so we can remove it.
    </p>
    <h2
      class="text-2xl font-bold mb-4"
    >
      Changes to This Policy
    </h2>
    <p
      class="mb-8"
    >
      We may update this policy from time to time. Changes will be reflected on this page with an updated effective date. Continued use of the service after changes constitutes acceptance of the updated policy.
    </p>
    <h2
      class="text-2xl font-bold mb-4"
    >
      Contact
    </h2>
    <p>
      For questions about this policy or to request data deletion, contact us at
       
      <a
        class="underline"
        href="mailto:contact@colormeup.co"
      >
        contact@colormeup.co
      </a>
      .
    </p>
  </div>
  <footer
    class="w-full flex items-center justify-center gap-2 flex-wrap p-4 text-foreground-500 border-t border-default"
    data-testid="Footer"
  >
    <div
      data-testid="Contact"
    >
      <button
        class="text-base"
