// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ScaleColorOptions > ChromaCurve > renders the tooltip 1`] = `
<div>
  <p
    class="mb-2"
  >
    Controls how color intensity changes across light and dark shades.
  </p>
  <p
    class="mb-1"
  >
    <b>
      Simple
    </b>
     scales chroma by a parabola (Amount), with Peak shifting where it bends.
  </p>
  <p>
    <b>
      Split
    </b>
     sets each end's chroma as a fraction of the gamut ceiling, interpolated across the steps.
  </p>
</div>
`;

exports[`ScaleColorOptions > HueShift > renders the tooltip 1`] = `
<div>
  <p
    class="mb-1"
  >
    Rotates hue toward the ends of the scale; the anchor step keeps the input hue.
  </p>
  <p
    class="mb-1"
  >
    <b>
      Simple
    </b>
     shifts the two ends by equal and opposite amounts (Amount).
  </p>
  <p>
    <b>
      Split
    </b>
     shifts each end (Low/High) independently.
  </p>
</div>
`;

exports[`ScaleColorOptions > LightnessCurve > renders the tooltip 1`] = `
<div>
  <p
    class="mb-1"
  >
    Controls how lightness is distributed across the scale.
  </p>
  <p
    class="mb-1"
  >
    <b>
      Simple
    </b>
     applies one easing curve (Amount) to the whole scale.
  </p>
  <p>
    <b>
      Split
    </b>
     sets the easing at each end (Low/High), interpolated across the scale.
  </p>
</div>
`;

exports[`ScaleColorOptions > LightnessRange > renders the tooltip 1`] = `
<div>
  <p
    class="mb-1"
  >
    Sets the lightest and darkest limits of the scale.
  </p>
  <p>
    Use this to avoid washed-out highlights or crushed shadows.
  </p>
</div>
`;

