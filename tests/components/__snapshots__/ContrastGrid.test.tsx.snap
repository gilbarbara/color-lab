  <p
    class="text-foreground-500 italic text-sm leading-snug mt-2"
  >
    <span>
      <span>
        L
        <sup>
          c
        </sup>
      </span>
       45 • Large text minimum
    </span>
  </p>
  <div
    class="mt-4"
  >
    <p
      class="text-foreground-500 text-sm"
    >
      Rows = text
    </p>
    <p
      class="text-foreground-500 text-sm"
    >
      Cols = background
    </p>
  </div>
</aside>
`;
